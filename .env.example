# SCCT Enquiry System — environment template
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# This file contains PLACEHOLDERS ONLY and is the only env file that is committed.
#
#   cp .env.example .env.local
#
# Every variable the APP needs is validated by `lib/env.ts` at import time, so a
# missing or malformed value fails the build rather than surfacing at runtime.
#
# DEMO_PASSWORD is the one exception: it is read only by the seed script, and is
# validated there. Making it an app requirement would break a deployment that has
# no reason to hold a demo credential.

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (M0 free tier is sufficient for the trial).
# Get it from: Atlas → Cluster → Connect → Drivers.
# Must start with mongodb:// or mongodb+srv://
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name. Kept separate from the URI so the same cluster can host
# a separate database for tests or a scratch environment.
MONGODB_DB=scct_enquiry

# ─── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign the staff session cookie. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
# NEVER reuse the example value, and never commit a real one.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Password given to every synthetic demo staff account by `npm run seed`.
# Minimum 12 characters.
#
# It lives here, and NOT in the seed script, because a committed password string
# is a secret in source control even when the accounts it opens are synthetic.
# Required only by the seed script; the running app never reads it.
#
# The value you choose is what goes in the README's demo-login section, so pick
# something you are willing to publish alongside accounts that hold no real data.
DEMO_PASSWORD=REPLACE_WITH_A_DEMO_PASSWORD_12_CHARS_MIN

# ─── Application ─────────────────────────────────────────────────────────────
# Public base URL of the deployed app. Used for absolute links.
# Local: http://localhost:3000   Vercel: https://<project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
