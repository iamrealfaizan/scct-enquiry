# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Documentation folder
docs/

# Environment secrets
.env
.env.*
!.env.example

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — ignore ALL of them except the committed placeholder template.
# The default create-next-app rule was `.env*.local` only, which would have
# allowed `.env` and `.env.production` to be committed. Secrets in source
# control is a listed critical failure, so this is deliberately broad.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
